{
  "name": "rolecontrol-iam-api",
  "version": "1.0.0",
  "description": "RoleControl IAM backend API with PostgreSQL-backed RBAC",
  "main": "index.js",
  "module": "ESNext",
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:setup": "node src/config/db.setup.ts",
    "db:seed": "tsx src/config/db.seed.ts",
    "migrate:create": "node-pg-migrate create --migration-file-language sql -m migrations",
    "migrate:up": "tsx src/config/db.migrate.ts up",
    "migrate:down": "tsx src/config/db.migrate.ts down",
    "migrate:status": "tsx src/config/db.migrate.ts status",
    "openapi:export": "tsx src/openapi/export.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/v2-integration/index.test.ts",
    "test:v1": "node --import tsx --test --test-concurrency=1 tests/v1-archive/index.test.ts",
    "test:v2": "node --import tsx --test --test-concurrency=1 tests/v2-integration/index.test.ts",
    "test:v3": "node --import tsx --test --test-concurrency=1 tests/v3-migrations/index.test.ts",
    "test:v4": "node --import tsx --test --test-concurrency=1 tests/v4-rate-limits/index.test.ts",
    "test:v5": "node --import tsx --test --test-concurrency=1 tests/v5-openapi/index.test.ts"
  },
  "keywords": [
    "RBAC",
    "postgresql",
    "trpc"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "1.4.7",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "9.0.3",
    "pg": "^8.19.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.2",
    "@types/pg": "^8.18.0",
    "@types/swagger-ui-express": "^4.1.8",
    "node-pg-migrate": "^8.0.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
